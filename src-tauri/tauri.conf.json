{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Launcher ADE",
  "version": "2.0.0",
  "identifier": "com.agentterminals.ade",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agent Launcher ADE",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 660,
        "backgroundColor": "#0b0e14"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/128x128.png", "icons/32x32.png"]
  }
}
