{
  "name": "agent-terminals",
  "version": "1.1.0",
  "description": "Launch multiple AI coding agents with split terminals",
  "main": "dist/main/main.js",
  "scripts": {
    "postinstall": "electron-rebuild -f -w node-pty || echo 'Note: native rebuild skipped (run on target machine)'",
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "webpack --config webpack.renderer.config.js --watch --mode development",
    "dev:main": "wait-on dist/renderer/index.html && electron .",
    "build:renderer": "webpack --config webpack.renderer.config.js --mode production",
    "build:main": "webpack --config webpack.main.config.js --mode production",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "rebuild": "electron-rebuild -f -w node-pty",
    "package": "npm run build && electron-builder",
    "build:tauri-renderer": "webpack --config webpack.tauri.config.js --mode production",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:linux": "tauri build --bundles deb,appimage"
  },
  "keywords": ["electron", "ai", "agents", "launcher", "terminal"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "concurrently": "^8.0.0",
    "css-loader": "^6.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "html-webpack-plugin": "^5.0.0",
    "style-loader": "^3.0.0",
    "ts-loader": "^9.0.0",
    "typescript": "^5.0.0",
    "wait-on": "^7.0.0",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "build": {
    "appId": "com.agentterminals.app",
    "productName": "Agent Launcher",
    "asar": true,
    "directories": { "output": "release" },
    "files": [
      {
        "from": ".",
        "to": ".",
        "filter": ["dist/**/*", "node_modules/**/*", "package.json"]
      }
    ],
    "asarUnpack": ["**/node_modules/node-pty/**/*"],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
